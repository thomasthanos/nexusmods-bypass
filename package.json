{
  "name": "nexusmods-bypass",
  "version": "3.3.2",
  "private": true,
  "description": "Development tooling for the NexusMods Bypass browser extension. The extension itself has no runtime dependencies.",
  "workspaces": [
    "workers/diagnostics",
    "workers/relay"
  ],
  "scripts": {
    "test": "node tools/build-zip.mjs",
    "test:dom": "node tests/unit/dom-fixtures-test.mjs",
    "lint": "eslint src tools tests workers/relay eslint.config.mjs playwright.config.mjs",
    "lint:webext": "node tools/build-zip.mjs && node tools/lint-webext.mjs",
    "build": "node tools/build-zip.mjs",
    "test:visual": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "addons-linter": "10.14.0",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "graphql": "^16.14.2",
    "jsdom": "^25.0.1"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
